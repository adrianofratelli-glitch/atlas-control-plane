# MongoDB Atlas Admin API
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_ORG_ID=
ATLAS_PROJECT_ID=

# Anthropic
ANTHROPIC_API_KEY=
# Optional: Claude model used for analysis and chat (defaults to claude-sonnet-5)
# CLAUDE_MODEL=claude-opus-4-8

# MongoDB connection string (optional: enables index creation and chat history)
MONGODB_URI=

# Optional: require "Authorization: Bearer <token>" on every /api request.
# Strongly recommended if the server is reachable beyond localhost — it holds
# real Atlas/Mongo credentials and every /api route can trigger billable or
# destructive actions.
API_AUTH_TOKEN=

# Retenção e limite do histórico embutido (evita documento crescer sem limite).
CHAT_MAX_MESSAGES=100
CHAT_RETENTION_DAYS=30

# Langfuse (trace do loop do assistente). Sem as duas chaves, tracing.py vira
# no-op — a demo roda igual, só sem observability. Ver ../observability/.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3001
