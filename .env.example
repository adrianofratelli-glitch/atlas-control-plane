# MongoDB Atlas Admin API
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_ORG_ID=
ATLAS_PROJECT_ID=

# LLM gateway (Grove). Every Claude call goes through it via pov-shared (grove_client).
# Without both values the assistant is disabled (fail closed); there is no fallback to a
# direct provider key. Usually filled by ../_shared/sync_env.py from PoVs/.env.shared.
GROVE_BASE_URL=https://<your-gateway-host>/anthropic
GROVE_API_KEY=
# Optional: second key used automatically when the first one is rotated/limited.
# GROVE_API_KEY_SECONDARY=
# Optional: Claude model (default claude-sonnet-5; haiku is mapped to claude-sonnet-5-5)
# CLAUDE_MODEL=claude-sonnet-5

# MongoDB connection string (optional: enables index creation and chat history)
MONGODB_URI=
# Optional: database for Torre's own state (chat history + LangGraph checkpoints)
# MONGODB_DB=torre

# Optional: require "Authorization: Bearer <token>" on every /api request.
# Strongly recommended if the server is reachable beyond localhost — it holds
# real Atlas/Mongo credentials and every /api route can trigger billable or
# destructive actions.
API_AUTH_TOKEN=

# Retenção e limite do histórico embutido (evita documento crescer sem limite).
CHAT_MAX_MESSAGES=100
CHAT_RETENTION_DAYS=30

# Langfuse (trace do loop do assistente). Sem as duas chaves, tracing.py vira
# no-op — a demo roda igual, só sem observability. Ver ../observability/.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3001

# Startup demo workload (bounded, read-only; existing PoV collections required)
TORRE_STRESS=1
STRESS_MINUTES=6
STRESS_WORKERS=6
